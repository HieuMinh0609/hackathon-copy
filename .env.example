# Sao chép thành .env rồi chỉnh giá trị (file .env không được commit)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
USER_ROLE=backend_developer
LOCAL_API_PORT=8765
# Backend local mặc định chỉ bind loopback. Docker Compose tự đặt API_HOST=0.0.0.0 bên trong container.
API_HOST=127.0.0.1

# Docker server: mặc định chỉ publish tại loopback để đặt reverse proxy phía trước.
BACKEND_PUBLISH_HOST=127.0.0.1
BACKEND_PORT=8765
# URL Ollama nhìn từ container backend. Với Ollama trên host, giữ host.docker.internal.
BACKEND_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Database: PostgreSQL (chạy nhanh: docker compose up -d db)
POSTGRES_HOST=localhost
POSTGRES_PUBLISH_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aibuddy
POSTGRES_USER=aibuddy
POSTGRES_PASSWORD=aibuddy
# DATABASE_URL=postgresql+psycopg://aibuddy:aibuddy@localhost:5432/aibuddy
# Prefix thư mục lưu trữ bộ cài đặt trên Server BE (Bảng app_catalog chỉ lưu suffix)
INSTALLER_PREFIX=data/installers
