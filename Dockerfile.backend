FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    API_HOST=0.0.0.0 \
    LOCAL_API_PORT=8765 \
    DATA_DIR=/app/data \
    INSTALLER_PREFIX=/app/data/installers

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 aibuddy \
    && useradd --system --uid 10001 --gid aibuddy --home-dir /app aibuddy

COPY requirements-backend.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-backend.txt

COPY backend ./backend
COPY config ./config
COPY shared ./shared
COPY documents ./documents

RUN mkdir -p /app/data /app/documents /app/logs \
    && chown -R aibuddy:aibuddy /app/data /app/documents /app/logs

USER aibuddy

EXPOSE 8765

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/api/v1/health/live', timeout=2)"]

CMD ["python", "-m", "backend.main"]
